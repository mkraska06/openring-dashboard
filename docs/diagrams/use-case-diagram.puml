@startuml OpenRing-Desktop-Use-Case-Diagram
' ===========================================================
' Use case diagram: OpenRing Desktop
' Compact, goal-oriented view of the implemented v1.0 application scope.
' AI assistance: German diagram labels were translated to English and adjusted
' to the documented v1.0 submission scope.
' ===========================================================

skinparam backgroundColor #FFFFFF
skinparam usecase {
    BackgroundColor #F5F9FF
    BorderColor #2B4F81
    ArrowColor #2B4F81
}
skinparam actor {
    BackgroundColor #FFF3E0
    BorderColor #8A5A00
}
skinparam packageStyle rectangle
left to right direction

actor "User" as User
actor "Colmi Ring" as Ring

rectangle "OpenRing Desktop" {

    usecase "Connect ring"                as UC_Connect
    usecase "Disconnect"                  as UC_Disconnect

    usecase "View live vital data"         as UC_Live
    usecase "Analyze vital history"        as UC_History
    usecase "Track activity data"          as UC_Activity
    usecase "Record and analyze\nmotion data" as UC_Motion
    usecase "Use Gesture Hub\ncontrols"    as UC_Gesture

    usecase "Export data"                 as UC_Export

    usecase "Use overlay"                 as UC_Overlay

    usecase "Use ring functions\n(find, restart, reset)" as UC_Device
}

' === User ===
User --> UC_Connect
User --> UC_Disconnect
User --> UC_Live
User --> UC_History
User --> UC_Activity
User --> UC_Motion
User --> UC_Gesture
User --> UC_Export
User --> UC_Overlay
User --> UC_Device

' === Colmi Ring (only where BLE communication is required) ===
UC_Connect  --> Ring
UC_Disconnect --> Ring
UC_Live     --> Ring
UC_History  --> Ring
UC_Activity --> Ring
UC_Motion   --> Ring
UC_Gesture  --> Ring
UC_Device   --> Ring

@enduml
